{
    // 启动调试的快捷键是F5
    "version": "0.2.0",
    "configurations": [
        // 使用dap-link(如无线调试器时的参考配置)
        {
           "name": "STLink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",

            "request": "launch",
            "type": "cortex-debug",

            "servertype": "stlink",

            "device": "STM32F407IG",

            "interface": "swd",

            "runToEntryPoint": "main",

            "svdFile": "${workspaceFolder}/STM32F407.svd",

            "gdbPath": "D:/msys64/mingw64/bin/gdb-multiarch.exe",

            "preLaunchTask": "build task",

            "rtos": "FreeRTOS",

            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        // 使用j-link进行调试时的参考配置
        {
            "name": "Jlink",
            "cwd": "${workspaceFolder}",

            "executable": "${workspaceFolder}/build/basic_framework.elf",

            "request": "launch",
            "type": "cortex-debug",

            "servertype": "jlink",

            // JLinkGDBServerCL.exe 路径
            "serverpath": "D:/JLink_V848/JLinkGDBServerCL.exe",

            // gdb路径
            "gdbPath": "D:/msys64/mingw64/bin/gdb-multiarch.exe",

            "device": "STM32F407IG",

            "interface": "swd",

            "runToEntryPoint": "main",

            "showDevDebugOutput": "none",

            "svdFile": "${workspaceFolder}/STM32F407.svd",

            "rtos": "D:/JLink_V848/GDBServer/RTOSPlugin_FreeRTOS.dll",

            "preLaunchTask": "build task", // 先运行Build任务
            "toolchainPrefix": "arm-none-eabi",
            "objdumpPath": "D:/msys64/mingw64/bin/arm-none-eabi-objdump.exe",

            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }

            //"preLaunchTask": "log", // 调试时同时开启RTT viewer窗口
        },
    ],
}